ARG BASE_IMAGE=python:3.12-bookworm
FROM ${BASE_IMAGE} AS runtime
USER root
RUN rm -rf /usr/local/lib/python*/site-packages
FROM scratch
# Reuse installed compiler/runtime files without carrying project or home directories.
COPY --from=runtime /usr /usr
COPY --from=runtime /lib /lib
COPY --from=runtime /lib64 /lib64
COPY --from=runtime /bin /bin
COPY --from=runtime /etc/ld.so.cache /etc/ld.so.cache
ENV PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8
WORKDIR /work
USER 65534:65534
